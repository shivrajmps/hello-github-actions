   "needed": 9
  },
  {
   "id": "players",
   "chapter": "Exchange, broker & regulator",
   "audio": "vo/s3.mp3",
   "audioFrom": 8,
   "from": 1129,
   "frames": 607,
   "phrases": [
    {
     "text": "Trading happens on an exchange,",
     "start": 8,
     "end": 71
    },
    {
     "text": "like the New York Stock Exchange, Nasdaq, or India's NSE.",
     "start": 71,
     "end": 208
    },
    {
     "text": "You can't trade there directly.",
     "start": 208,
     "end": 267
    },
    {
     "text": "Your order goes through a broker,",
     "start": 267,
     "end": 321
    },
    {
     "text": "the app or firm licensed to reach the exchange.",
     "start": 321,
     "end": 418
    },
    {
     "text": "And a regulator,",
     "start": 418,
     "end": 452
    },
    {
     "text": "like the SEC in the US, or SEBI in India,",
     "start": 452,
     "end": 551
    },
    {
     "text": "polices the rules.",
     "start": 551,
     "end": 583
    }
   ],
   "snapped": 7,
